        ],
        "id": "boost-mode-active"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Toggle away mode",
          "nl": "Afwezigheidsmodus schakelen"
        },
        "titleFormatted": {
          "en": "Turn away mode [[enabled]]",
          "nl": "Zet afwezigheidsmodus [[enabled]]"
        },
        "hint": {
          "en": "Enable or disable away mode.",
          "nl": "Schakel de afwezigheidsmodus in of uit."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=boiler"
          },
          {
            "type": "dropdown",
            "name": "enabled",
            "title": {
              "en": "Enabled",
              "nl": "Ingeschakeld"
            },
            "values": [
              {
                "id": "true",
                "label": {
                  "en": "on",
                  "nl": "aan"
                }
              },
              {
                "id": "false",
                "label": {
                  "en": "off",
                  "nl": "uit"
                }
              }
            ]
          }
        ],
        "id": "set-away-mode"
      },
      {
        "title": {
          "en": "Toggle boost mode",
          "nl": "Boostmodus schakelen"
        },
        "titleFormatted": {
          "en": "Turn boost mode [[enabled]]",
          "nl": "Zet boostmodus [[enabled]]"
        },
        "hint": {
          "en": "Enable or disable boost mode.",
          "nl": "Schakel de boostmodus in of uit."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=water-heater"
          },
          {
            "type": "dropdown",
            "name": "enabled",
            "title": {
              "en": "Enabled",
              "nl": "Ingeschakeld"
            },
            "values": [
              {
                "id": "true",
                "label": {
                  "en": "on",
                  "nl": "aan"
                }
              },
              {
                "id": "false",
                "label": {
                  "en": "off",
                  "nl": "uit"
                }
              }
            ]
          }
        ],
        "id": "set-boost-mode"
      },
      {
        "title": {
          "en": "Set heating mode",
          "nl": "Verwarmingsmodus instellen"
        },
        "titleFormatted": {
          "en": "Set heating mode to [[mode]]",
          "nl": "Zet verwarmingsmodus op [[mode]]"
        },
        "hint": {
          "en": "Set the heating mode of the device.",
          "nl": "Stel de verwarmingsmodus van het apparaat in."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=boiler|water-heater"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Mode",
              "nl": "Modus"
            },
            "values": [
              {
                "id": "manual",
                "label": {
                  "en": "Manual",
                  "nl": "Handmatig"
                }
              },
              {
                "id": "eco_plus",
                "label": {
                  "en": "Eco+",
                  "nl": "Eco+"
                }
              },
              {
                "id": "prog",
                "label": {
                  "en": "Program",
                  "nl": "Programma"
                }
              }
            ]
          }
        ],
        "id": "set-heating-mode"
      }
    ]
  },
