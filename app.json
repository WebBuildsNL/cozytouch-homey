  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Boost mode turned off",
          "nl": "Boostmodus ging uit"
        },
        "hint": {
          "en": "Triggers when boost mode is turned off.",
          "nl": "Wordt getriggerd wanneer de boostmodus wordt uitgeschakeld."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=water-heater"
          }
        ],
        "id": "boost-mode-turned-off"
      },
      {
        "title": {
          "en": "Boost mode turned on",
          "nl": "Boostmodus ging aan"
        },
        "hint": {
          "en": "Triggers when boost mode is turned on.",
          "nl": "Wordt getriggerd wanneer de boostmodus wordt ingeschakeld."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=water-heater"
          }
        ],
        "id": "boost-mode-turned-on"
      },
      {
        "title": {
          "en": "Heating mode changed",
          "nl": "Verwarmingsmodus is veranderd"
        },
        "hint": {
          "en": "Triggers when the heating mode changes.",
          "nl": "Wordt getriggerd wanneer de verwarmingsmodus verandert."
        },
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode",
              "nl": "Modus"
            },
            "example": {
              "en": "eco_plus",
              "nl": "eco_plus"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=boiler|water-heater"
          }
        ],
        "id": "heating-mode-changed"
      },
      {
        "title": {
          "en": "Hot water available dropped below...",
          "nl": "Warm water beschikbaar zakte onder..."
        },
        "titleFormatted": {
          "en": "Hot water available dropped below [[percentage]]%",
          "nl": "Warm water beschikbaar zakte onder [[percentage]]%"
        },
        "hint": {
          "en": "Triggers when the available hot water percentage drops below the given threshold.",
          "nl": "Wordt getriggerd wanneer het percentage beschikbaar warm water onder de opgegeven grens zakt."
        },
        "tokens": [
          {
            "name": "percentage",
            "type": "number",
            "title": {
              "en": "Percentage",
              "nl": "Percentage"
            },
            "example": 45
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=water-heater"
          },
          {
            "type": "number",
            "name": "percentage",
            "title": {
              "en": "Percentage",
              "nl": "Percentage"
            },
            "min": 0,
            "max": 100,
            "step": 1,
            "placeholder": {
              "en": "50",
              "nl": "50"
            }
          }
        ],
        "id": "hot-water-below"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "Boost mode is !{{on|off}}",
          "nl": "Boostmodus is !{{aan|uit}}"
        },
        "hint": {
          "en": "Check if boost mode is currently active.",
          "nl": "Controleer of de boostmodus momenteel actief is."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=water-heater"
