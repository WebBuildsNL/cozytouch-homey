{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "nl.webbuilds.cozytouch",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Cozytouch"
  },
  "description": {
    "en": "Control your Atlantic, Thermor, and Sauter devices via Cozytouch",
    "nl": "Bedien je Atlantic, Thermor en Sauter apparaten via Cozytouch"
  },
  "category": [
    "climate"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "brandColor": "#E63312",
  "author": {
    "name": "Dennis Smink",
    "email": "dennissmink@gmail.com"
  },
  "api": {
    "testCredentials": {
      "method": "POST",
      "path": "/test-credentials"
    }
  },
  "flow": {
    "conditions": [
      {
        "title": {
          "en": "Boost mode is !{{on|off}}",
          "nl": "Boostmodus is !{{aan|uit}}"
        },
        "hint": {
          "en": "Check if boost mode is currently active.",
          "nl": "Controleer of de boostmodus momenteel actief is."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=water-heater"
          }
        ],
        "id": "boost-mode-active"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Toggle away mode"
        },
        "titleFormatted": {
          "en": "Turn away mode [[enabled]]"
        },
        "hint": {
          "en": "Enable or disable away mode."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=boiler"
          },
          {
            "type": "dropdown",
            "name": "enabled",
            "title": {
              "en": "Enabled"
            },
            "values": [
              {
                "id": "true",
                "label": {
                  "en": "On"
                }
              },
              {
                "id": "false",
                "label": {
                  "en": "Off"
                }
              }
            ]
          }
        ],
        "id": "set-away-mode"
      },
      {
        "title": {
          "en": "Toggle boost mode"
        },
        "titleFormatted": {
          "en": "Turn boost mode [[enabled]]"
        },
        "hint": {
          "en": "Enable or disable boost mode."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=water-heater"
          },
          {
            "type": "dropdown",
            "name": "enabled",
            "title": {
              "en": "Enabled"
            },
            "values": [
              {
                "id": "true",
                "label": {
                  "en": "On"
                }
              },
              {
                "id": "false",
                "label": {
                  "en": "Off"
                }
              }
            ]
          }
        ],
        "id": "set-boost-mode"
      },
      {
        "title": {
          "en": "Set heating mode"
        },
        "titleFormatted": {
          "en": "Set heating mode to [[mode]]"
        },
        "hint": {
          "en": "Set the heating mode of the device."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=boiler|water-heater"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Mode"
            },
            "values": [
              {
                "id": "manual",
                "label": {
                  "en": "Manual"
                }
              },
              {
                "id": "eco_plus",
                "label": {
                  "en": "Eco+"
                }
              },
              {
                "id": "prog",
                "label": {
                  "en": "Program"
                }
              }
            ]
          }
        ],
        "id": "set-heating-mode"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Air Conditioner"
      },
      "class": "thermostat",
      "capabilities": [
        "thermostat_mode",
        "target_temperature",
        "measure_temperature",
        "cozytouch_fan_mode",
        "cozytouch_swing_mode",
        "meter_power"
      ],
      "capabilitiesOptions": {
        "thermostat_mode": {
          "values": [
            {
              "id": "off",
              "title": {
                "en": "Off"
              }
            },
            {
              "id": "auto",
              "title": {
                "en": "Auto"
              }
            },
            {
              "id": "cool",
              "title": {
                "en": "Cool"
              }
            },
            {
              "id": "heat",
              "title": {
                "en": "Heat"
              }
            }
          ]
        },
        "target_temperature": {
          "min": 0,
          "max": 30,
          "step": 0.5
        }
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "usernameLabel": {
              "en": "Email"
            },
            "usernamePlaceholder": {
              "en": "your@email.com"
            },
            "passwordLabel": {
              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": "Your Cozytouch password"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "images": {
        "small": "/drivers/air-conditioner/assets/small.png",
        "large": "/drivers/air-conditioner/assets/large.png"
      },
      "id": "air-conditioner"
    },
    {
      "name": {
        "en": "Boiler / Heat Pump"
      },
      "class": "thermostat",
      "capabilities": [
        "thermostat_mode",
        "target_temperature",
        "measure_temperature",
        "heating_mode",
        "away_mode",
        "meter_power"
      ],
      "capabilitiesOptions": {
        "thermostat_mode": {
          "values": [
            {
              "id": "off",
              "title": {
                "en": "Off"
              }
            },
            {
              "id": "heat",
              "title": {
                "en": "Heat"
              }
            },
            {
              "id": "auto",
              "title": {
                "en": "Auto"
              }
            }
          ]
        },
        "target_temperature": {
          "min": 0,
          "max": 30,
          "step": 0.5
        }
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "usernameLabel": {
              "en": "Email"
            },
            "usernamePlaceholder": {
              "en": "your@email.com"
            },
            "passwordLabel": {
              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": "Your Cozytouch password"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "images": {
        "small": "/drivers/boiler/assets/small.png",
        "large": "/drivers/boiler/assets/large.png"
      },
      "id": "boiler"
    },
    {
      "name": {
        "en": "Towel Rack"
      },
      "class": "heater",
      "capabilities": [
        "onoff",
        "measure_temperature"
      ],
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "usernameLabel": {
              "en": "Email"
            },
            "usernamePlaceholder": {
              "en": "your@email.com"
            },
            "passwordLabel": {
              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": "Your Cozytouch password"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "images": {
        "small": "/drivers/towel-rack/assets/small.png",
        "large": "/drivers/towel-rack/assets/large.png"
      },
      "id": "towel-rack"
    },
    {
      "name": {
        "en": "Water Heater"
      },
      "class": "heater",
      "capabilities": [
        "target_temperature",
        "measure_temperature",
        "water_temperature",
        "heating_schedule",
        "inlet_temperature",
        "outlet_temperature",
        "measure_water",
        "heating_mode",
        "boost_mode",
        "meter_power"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 30,
          "max": 65,
          "step": 1
        },
        "measure_temperature": {
          "title": {
            "en": "Water Temperature",
            "nl": "Watertemperatuur"
          },
          "insights": true
        }
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "usernameLabel": {
              "en": "Email"
            },
            "usernamePlaceholder": {
              "en": "your@email.com"
            },
            "passwordLabel": {
              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": "Your Cozytouch password"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "images": {
        "small": "/drivers/water-heater/assets/small.png",
        "large": "/drivers/water-heater/assets/large.png"
      },
      "id": "water-heater"
    }
  ],
  "capabilities": {
    "away_mode": {
      "type": "boolean",
      "title": {
        "en": "Away Mode",
        "nl": "Afwezigheidsmodus"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle"
    },
    "boost_mode": {
      "type": "boolean",
      "title": {
        "en": "Boost Mode",
        "nl": "Boostmodus"
      },
      "getable": true,
      "setable": true,
      "insights": true,
      "insightsTitleTrue": {
        "en": "Boost enabled",
        "nl": "Boost ingeschakeld"
      },
      "insightsTitleFalse": {
        "en": "Boost disabled",
        "nl": "Boost uitgeschakeld"
      },
      "uiComponent": "toggle",
      "icon": "/assets/boost.svg"
    },
    "cozytouch_fan_mode": {
      "type": "enum",
      "title": {
        "en": "Fan Mode",
        "nl": "Ventilatormodus"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "low",
          "title": {
            "en": "Low",
            "nl": "Laag"
          }
        },
        {
          "id": "medium",
          "title": {
            "en": "Medium",
            "nl": "Gemiddeld"
          }
        },
        {
          "id": "high",
